# Target Git repository (owner/repo or full clone URL)
GITSTORE_REPO=username/my-data-repo

# Target branch (defaults to main)
GITSTORE_BRANCH=main

# GitHub Personal Access Token (requires repo or Contents read/write scope)
GITHUB_TOKEN=ghp_yourTokenHere

# Base path in repository (defaults to 'data')
GITSTORE_BASE_PATH=data
